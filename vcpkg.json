{
  "dependencies": [
    "argparse",
    "fastgltf",
    "glm",
    {
      "name": "imgui",
      "features": [
        "sdl3-binding",
        "vulkan-binding"
      ]
    },
    "meshoptimizer",
    "mikktspace",
    {
      "name": "sdl3",
      "features": [
        "vulkan"
      ]
    },
    {
      "name": "sdl3-image",
      "features": [
        "png"
      ]
    },
    "shaderc",
    "tbb",
    "vulkan",
    "vulkan-memory-allocator",
    "vulkan-validationlayers"
  ],
  "overrides": [
    { "name": "fastgltf", "version": "0.9.1" }
  ],
  "features": {
    "tracy": {
      "description": "Enable Tracy profiler support",
      "dependencies": [ "tracy" ]
    }
  }
}
