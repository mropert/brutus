#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require

#include "constants.glsl"
#include "math.glsl"
#include "mesh.glsl"

// Uses mesh.glsl
#include "draw_commands.glsl"

layout( local_size_x = TASK_GROUP_SIZE, local_size_y = 1, local_size_z = 1 ) in;

layout( std430, set = 1, binding = 0 ) readonly buffer ssbo1
{
	Mesh meshes[];
};
layout( std430, set = 1, binding = 1 ) readonly buffer ssbo2
{
	Material materials[];
};

layout( set = 0, binding = 0 ) uniform texture2D textures[ 1024 ];
layout( set = 0, binding = 2 ) uniform sampler samplers[ 8 ];

layout( buffer_reference, std430 ) buffer MeshletVisibilityBuffer
{
	uint bits[];
};

const uint MESHLET_PASS_NONE = 0; // Draw all meshlets that pass frustum and cone culling
const uint MESHLET_PASS_EARLY = 1; // Only meshlets visible last frame
const uint MESHLET_PASS_LATE = 2; // Test meshlets against the depth pyramid, update their visibility

layout( push_constant, std430 ) uniform block
{
	FrameConstants frame_constants;
	PassConstants pass_constants;
	MeshDrawBuffer draws_buffer;
	TaskCommandsBuffer commands_buffer;
	MeshletVisibilityBuffer meshlet_visibility;
	uint depth_pyramid;
	uint meshlet_pass;
	uint draw_bin;
};

// Shadow passes use their own (depth-only) LOD chain, uniform for the whole draw
MeshLOD get_mesh_lod( uint mesh_id, uint lod )
{
	return pass_constants.data.shadow_pass != 0 ? meshes[ mesh_id ].shadow_lods[ lod ] : meshes[ mesh_id ].lods[ lod ];
}

// Each invocation's sort key, view depth or +infinity when it draws nothing
shared float meshlet_keys[ TASK_GROUP_SIZE ];

taskPayloadSharedEXT MeshletTaskPayload payload;

// Meshlet backface cone culling, using meshoptimizer's cone axis/cutoff.
// Convention: projection_matrix[3][3] is 0 for perspective and 1 for orthographic projections (same check as mesh_cull.comp).
// - Perspective: the view direction depends on where the meshlet is relative to the camera position.
// - Orthographic (eg: directional light shadow maps): all view rays are parallel to the camera forward axis,
//   so the test only depends on that direction (the meshlet bounding sphere doesn't matter).
bool coneCull( vec3 center, float radius, vec3 cone_axis, float cone_cutoff, vec3 camera_position )
{
	return dot( center - camera_position, cone_axis ) >= cone_cutoff * length( center - camera_position ) + radius;
}

bool coneCullOrthographic( vec3 cone_axis, float cone_cutoff, vec3 view_direction )
{
	return dot( view_direction, cone_axis ) >= cone_cutoff;
}

// True when this pass draws the meshlet: it passes culling and, in the late pass, wasn't drawn by the early pass.
// The late pass also records the meshlet's visibility for the next frame
bool should_draw_meshlet( uint draw_id, uint mesh_id, uint meshlet_id, bool drawn_early, out float view_depth )
{
	const Meshlet meshlet = meshes[ mesh_id ].mb.meshlets[ meshlet_id ];

	const vec3 meshlet_center = rotate_by_quaternion( meshlet.bounding_sphere.xyz, draws_buffer.mesh_draws[ draw_id ].rotation )
			* draws_buffer.mesh_draws[ draw_id ].scale
		+ draws_buffer.mesh_draws[ draw_id ].translation;
	// View space looks down -Z, for the orthographic shadow views too
	view_depth = -( pass_constants.data.view_matrix * vec4( meshlet_center, 1 ) ).z;

	const float meshlet_radius = meshlet.bounding_sphere.w
		* max( draws_buffer.mesh_draws[ draw_id ].scale.x,
			   max( draws_buffer.mesh_draws[ draw_id ].scale.y, draws_buffer.mesh_draws[ draw_id ].scale.z ) );
	const vec3 cone_axis = rotate_by_quaternion( meshlet.cone.xyz, draws_buffer.mesh_draws[ draw_id ].rotation );

	bool visible = true;
	if ( is_single_sided( materials[ draws_buffer.mesh_draws[ draw_id ].material ].type ) )
	{
		// Uniform across the whole draw, so the branch doesn't diverge
		const bool orthographic = pass_constants.data.projection_matrix[ 3 ][ 3 ] != 0.0;
		if ( orthographic )
		{
			// View space looks down -Z
			const vec3 view_direction = -pass_constants.data.inverse_view_matrix[ 2 ].xyz;
			visible = visible && !coneCullOrthographic( cone_axis, meshlet.cone.w, view_direction );
		}
		else
		{
			visible = visible && !coneCull( meshlet_center, meshlet_radius, cone_axis, meshlet.cone.w, pass_constants.data.view_position );
		}
	}
	for ( int i = 0; i < 6; ++i )
	{
		visible = visible && dot( pass_constants.data.frustum[ i ], vec4( meshlet_center, 1 ) ) > -meshlet_radius;
	}
	if ( pass_constants.data.shadow_pass != 0 )
	{
		visible = visible && shadow_caster_visible( pass_constants, meshlet_center, meshlet_radius );
	}

	bool skip = false;
	// Only main LOD meshlets have visibility bits, shadow passes use MESHLET_PASS_NONE
	if ( meshlet_pass != MESHLET_PASS_NONE )
	{
		const uint visibility_bit = draws_buffer.mesh_draws[ draw_id ].meshlet_visibility_offset + meshlet_id;
		const uint visibility_word = visibility_bit >> 5;
		const uint visibility_mask = 1u << ( visibility_bit & 31 );
		const bool was_visible = ( meshlet_visibility.bits[ visibility_word ] & visibility_mask ) != 0;
		if ( meshlet_pass == MESHLET_PASS_EARLY )
		{
			visible = visible && was_visible;
		}
		else
		{
			if ( visible )
			{
				vec4 aabb;
				const vec3 center = ( pass_constants.data.view_matrix * vec4( meshlet_center, 1 ) ).xyz * vec3( 1, 1, -1 );
				const float znear = pass_constants.data.projection_matrix[ 3 ][ 2 ];
				const uint pyramidWidth = 1024;
				const uint pyramidHeight = 1024;
				if ( projectSphere( center,
									meshlet_radius,
									znear,
									pass_constants.data.projection_matrix[ 0 ][ 0 ],
									pass_constants.data.projection_matrix[ 1 ][ 1 ],
									aabb ) )
				{
					const float width = ( aabb.z - aabb.x ) * pyramidWidth;
					const float height = ( aabb.w - aabb.y ) * pyramidHeight;
					const float level = ceil( log2( max( width, height ) ) );
					const float
						depth = textureLod( sampler2D( textures[ depth_pyramid ], samplers[ 1 ] ), ( aabb.xy + aabb.zw ) * 0.5, level ).x;
					const float depth_sphere = znear / ( center.z - meshlet_radius );
					visible = depth_sphere > depth;
				}
			}

			if ( visible != was_visible )
			{
				if ( visible )
				{
					atomicOr( meshlet_visibility.bits[ visibility_word ], visibility_mask );
				}
				else
				{
					atomicAnd( meshlet_visibility.bits[ visibility_word ], ~visibility_mask );
				}
			}

			// Already drawn by the early pass
			skip = was_visible && drawn_early;
		}
	}

	return visible && !skip;
}

void main()
{
	const MeshTaskCommand command = commands_buffer.commands[ commands_buffer.headers[ draw_bin ].first_command + gl_WorkGroupID.x ];
	const uint draw_id = command.draw_id;
	const uint mesh_id = draws_buffer.mesh_draws[ draw_id ].mesh;

	const uint lod = draw_bin % DRAW_BINS_PER_BUCKET; // The sort key is the LOD
	const MeshLOD mesh_lod = get_mesh_lod( mesh_id, lod );
	const bool drawn_early = ( command.first_meshlet & TASK_COMMAND_DRAWN_EARLY ) != 0;
	const uint lod_meshlet = ( command.first_meshlet & ~TASK_COMMAND_DRAWN_EARLY ) + gl_LocalInvocationIndex;
	// No early return: every invocation must reach EmitMeshTasksEXT (mandated by task shader spec, else UB).
	// Invocations past the LOD's last meshlet draw nothing
	const uint meshlet_id = lod_meshlet + mesh_lod.meshlets_offset;
	float key = INFINITY;
	float view_depth;
	if ( lod_meshlet < mesh_lod.meshlets_count && should_draw_meshlet( draw_id, mesh_id, meshlet_id, drawn_early, view_depth ) )
	{
		key = view_depth;
	}
	meshlet_keys[ gl_LocalInvocationIndex ] = key;
	barrier();

	// Front to back: each drawn meshlet's place in the payload is the number of nearer ones, ties broken by invocation
	uint rank = 0;
	uint count = 0;
	for ( uint i = 0; i < TASK_GROUP_SIZE; ++i )
	{
		const float other = meshlet_keys[ i ];
		rank += ( other < key || ( other == key && i < gl_LocalInvocationIndex ) ) ? 1 : 0;
		count += isinf( other ) ? 0 : 1;
	}
	if ( !isinf( key ) )
	{
		payload.meshlets[ rank ] = meshlet_id;
	}
	if ( gl_LocalInvocationIndex == 0 )
	{
		payload.draw_id = draw_id;
		payload.shadow_lod_offset = shadow_lod_offset( pass_constants, mesh_lod, draws_buffer.mesh_draws[ draw_id ].scale );
	}
	barrier();

	EmitMeshTasksEXT( count, 1, 1 );
}
