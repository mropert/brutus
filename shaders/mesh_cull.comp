#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require

#include "constants.glsl"
#include "math.glsl"
#include "mesh.glsl"

// Uses mesh.glsl
#include "draw_commands.glsl"

layout( local_size_x = 32, local_size_y = 1, local_size_z = 1 ) in;

layout( set = 0, binding = 0 ) uniform texture2D textures[ 1024 ];
layout( set = 0, binding = 2 ) uniform sampler samplers[ 8 ];
layout( std430, set = 1, binding = 0 ) readonly buffer ssbo1
{
	Mesh meshes[];
};
layout( std430, set = 1, binding = 1 ) readonly buffer ssbo2
{
	Material materials[];
};

// Culling only counts each bin's commands and reserves each draw's commands in its bin, mesh_commands.comp writes the
// commands once the bins are packed. TASK_COMMANDS: mesh shader path, one MeshTaskCommand per task workgroup. Otherwise one
// MeshDrawCommand per draw for the vertex path
#if TASK_COMMANDS
#define CommandsBuffer TaskCommandsBuffer
#else
#define CommandsBuffer MeshDrawCommandsBuffer
#endif
layout( buffer_reference, std430 ) buffer VisibilityBuffer
{
	uint8_t draws[];
};
layout( buffer_reference, std430 ) buffer DrawStatisticsBuffer
{
	uint meshes[ MESH_LOD_COUNT ];
	uint indices[ MESH_LOD_COUNT ];
};

// Statistics are accumulated per workgroup then flushed once, to limit global atomics
shared uint group_meshes[ MESH_LOD_COUNT ];
shared uint group_indices[ MESH_LOD_COUNT ];

layout( push_constant ) uniform block
{
	MeshDrawBuffer draws_buffer;
	CommandsBuffer commands_buffer;
	DrawSlotsBuffer slots_buffer;
	VisibilityBuffer visibility_buffer;
	DrawStatisticsBuffer statistics_buffer;
	PassConstants pass_constants;
	uint draws_count;
	uint depth_pyramid;
	uint meshlet_occlusion; // Non-zero when task shaders cull meshlets against the depth pyramid
};

// Shadow passes use their own (depth-only) LOD chain, uniform for the whole dispatch
MeshLOD get_mesh_lod( uint mesh_id, uint lod )
{
	return pass_constants.data.shadow_pass != 0 ? meshes[ mesh_id ].shadow_lods[ lod ] : meshes[ mesh_id ].lods[ lod ];
}

void cull_draw( uint draw_id )
{
	const bool was_visible = uint( visibility_buffer.draws[ draw_id ] ) == 1;
	if ( !LATE && !was_visible )
	{
		slots_buffer.slots[ draw_id ].bin = DRAW_NOT_BINNED;
		return;
	}

	const uint mesh_id = draws_buffer.mesh_draws[ draw_id ].mesh;
	const vec3 mesh_center = rotate_by_quaternion( meshes[ mesh_id ].bounding_sphere.xyz, draws_buffer.mesh_draws[ draw_id ].rotation )
			* draws_buffer.mesh_draws[ draw_id ].scale
		+ draws_buffer.mesh_draws[ draw_id ].translation;
	const float mesh_scale = max( draws_buffer.mesh_draws[ draw_id ].scale.x,
								  max( draws_buffer.mesh_draws[ draw_id ].scale.y, draws_buffer.mesh_draws[ draw_id ].scale.z ) );
	const float mesh_radius = meshes[ mesh_id ].bounding_sphere.w * mesh_scale;
	bool visible = true;
	for ( int i = 0; i < 6; ++i )
	{
		visible = visible && dot( pass_constants.data.frustum[ i ], vec4( mesh_center, 1 ) ) > -mesh_radius;
	}
	if ( pass_constants.data.shadow_pass != 0 )
	{
		visible = visible && shadow_caster_visible( pass_constants, mesh_center, mesh_radius );
	}

	if ( LATE && visible )
	{
		vec4 aabb;
		const vec3 center = ( pass_constants.data.view_matrix * vec4( mesh_center, 1 ) ).xyz * vec3( 1, 1, -1 );
		const float znear = pass_constants.data.projection_matrix[ 3 ][ 2 ];
		const uint pyramidWidth = 1024;
		const uint pyramidHeight = 1024;
		if ( projectSphere( center,
							mesh_radius,
							znear,
							pass_constants.data.projection_matrix[ 0 ][ 0 ],
							pass_constants.data.projection_matrix[ 1 ][ 1 ],
							aabb ) )
		{
			const float width = ( aabb.z - aabb.x ) * pyramidWidth;
			const float height = ( aabb.w - aabb.y ) * pyramidHeight;
			const float level = ceil( log2( max( width, height ) ) );
			const float depth = textureLod( sampler2D( textures[ depth_pyramid ], samplers[ 1 ] ), ( aabb.xy + aabb.zw ) * 0.5, level ).x;
			const float depthSphere = znear / ( center.z - mesh_radius );

			visible = visible && depthSphere > depth;
		}
	}

	// With meshlet occlusion, draws already drawn by the early pass are emitted again so that task shaders can test the
	// meshlets that were hidden last frame
	const bool drawn_early = LATE && was_visible;
	if ( visible && ( !drawn_early || meshlet_occlusion != 0 ) )
	{
		// Both passes must select the same LOD: meshlet visibility bits are per LOD, and the late pass skips the meshlets
		// the early pass drew
		float dist = 1;
		if ( pass_constants.data.projection_matrix[ 3 ][ 3 ] == 0.f )
		{
			dist = max( distance( pass_constants.data.view_position, mesh_center ) - mesh_radius, 0.0 );
		}
		const float threshold = dist * pass_constants.data.lod_target / mesh_scale;

		int lod = 0;
		for ( int i = 1; i < MESH_LOD_COUNT; ++i )
		{
			if ( get_mesh_lod( mesh_id, i ).error < threshold )
				lod = i;
		}
		const MeshLOD mesh_lod = get_mesh_lod( mesh_id, lod );

		const uint bucket = materials[ draws_buffer.mesh_draws[ draw_id ].material ].type;
		const uint bin = bucket * DRAW_BINS_PER_BUCKET + lod; // The sort key is the LOD
#if TASK_COMMANDS
		const uint group_count = ( mesh_lod.meshlets_count + TASK_GROUP_SIZE - 1 ) / TASK_GROUP_SIZE;
		slots_buffer.slots[ draw_id ].offset_in_bin = atomicAdd( commands_buffer.headers[ bin ].group_count_x, group_count );
#else
		slots_buffer.slots[ draw_id ].offset_in_bin = atomicAdd( commands_buffer.bin_counts[ bin ], 1 );
#endif
		slots_buffer.slots[ draw_id ].bin = bin | ( drawn_early ? DRAW_SLOT_DRAWN_EARLY : 0 );

		if ( !drawn_early )
		{
			atomicAdd( group_meshes[ lod ], 1 );
			atomicAdd( group_indices[ lod ], mesh_lod.indices_count );
		}
	}
	else
	{
		slots_buffer.slots[ draw_id ].bin = DRAW_NOT_BINNED;
	}

	if ( LATE )
	{
		visibility_buffer.draws[ draw_id ] = uint8_t( visible ? 1 : 0 );
	}
}

void main()
{
	if ( gl_LocalInvocationIndex < MESH_LOD_COUNT )
	{
		group_meshes[ gl_LocalInvocationIndex ] = 0;
		group_indices[ gl_LocalInvocationIndex ] = 0;
	}
	barrier();

	const uint draw_id = gl_GlobalInvocationID.x;
	if ( draw_id < draws_count )
	{
		cull_draw( draw_id );
	}
	barrier();

	if ( gl_LocalInvocationIndex < MESH_LOD_COUNT && group_meshes[ gl_LocalInvocationIndex ] != 0 )
	{
		atomicAdd( statistics_buffer.meshes[ gl_LocalInvocationIndex ], group_meshes[ gl_LocalInvocationIndex ] );
		atomicAdd( statistics_buffer.indices[ gl_LocalInvocationIndex ], group_indices[ gl_LocalInvocationIndex ] );
	}
}
