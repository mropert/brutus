#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_GOOGLE_include_directive : require

#include "constants.glsl"
#include "mesh.glsl"

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
layout(triangles, max_vertices = 64, max_primitives = 96) out;

layout(std430, set = 1, binding = 0) readonly buffer ssbo1 { Mesh meshes[]; };

layout (location = 0) out vec2 outUV[];
layout (location = 1) out vec3 outWorldPos[];
layout (location = 2) out vec3 outNormal[];
layout (location = 3) out vec3 outTangent[];
layout (location = 4) out vec3 outBitangent[];
layout (location = 5) out flat uint outMaterial[];

layout(buffer_reference, std430) readonly buffer DrawCommandsBuffer { MeshDrawCommand commands[]; };

layout( push_constant, std430 ) uniform block
{
    SceneConstants scene_constants;
    MeshDrawBuffer draws_buffer;
    DrawCommandsBuffer commands_buffer;
};

taskPayloadSharedEXT MeshletTaskPayload payload;

void main()
{
    const uint draw_id = payload.draw_id;
    const uint mesh_id = draws_buffer.mesh_draws[draw_id].mesh;

    const uint meshlet_id = payload.meshlets[gl_WorkGroupID.x];
    Meshlet meshlet = meshes[mesh_id].mb.meshlets[meshlet_id];
    SetMeshOutputsEXT(meshlet.vertex_count, meshlet.triangle_count);

    for (uint i = gl_LocalInvocationIndex; i < meshlet.vertex_count; i += gl_WorkGroupSize.x) {
        const uint index = meshes[mesh_id].mvb.meshlet_vertices[meshlet.vertex_offset + i];
        const Vertex v = meshes[mesh_id].vb.vertices[index];
        const vec3 pos = v.position + draws_buffer.mesh_draws[draw_id].translation;
        gl_MeshVerticesEXT[i].gl_Position = scene_constants.view_projection_matrix * vec4(pos, 1);
        outUV[i].x = v.uv_x;
        outUV[i].y = v.uv_y;
        outNormal[i] = v.normal;
        outWorldPos[i] = pos;
        outTangent[i] = v.tangent.xyz;
        outBitangent[i] = cross(outNormal[i], outTangent[i]) * v.tangent.w;
        outMaterial[i] = draws_buffer.mesh_draws[draw_id].material;
    }

    for (uint i = gl_LocalInvocationIndex; i < meshlet.triangle_count; i += gl_WorkGroupSize.x) {
        const uint offset = meshlet.triangle_offset + i * 3;
        gl_PrimitiveTriangleIndicesEXT[i] = uvec3(
            meshes[mesh_id].mtb.meshlet_triangles[offset],
            meshes[mesh_id].mtb.meshlet_triangles[offset + 1],
            meshes[mesh_id].mtb.meshlet_triangles[offset + 2]);
    }
}
