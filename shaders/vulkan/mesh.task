#version 450
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_mesh_shader: require
#extension GL_EXT_shader_8bit_storage: require
#extension GL_GOOGLE_include_directive : require

#include "constants.glsl"
#include "mesh.glsl"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 1, binding = 0) readonly buffer ssbo1 { Mesh meshes[]; };

layout( push_constant ) uniform constants
{
    uint mesh;
    uint material;
    SceneConstants scene_constants;
    InstanceBuffer instance_buffer;
    float lod_cutoff;
} PushConstants;

taskPayloadSharedEXT MeshletTaskPayload payload;

void main()
{
    vec3 world_position = vec3(gl_WorkGroupID) - (vec3(gl_NumWorkGroups / 2));
    world_position.y = 0;
    vec4 view_position = PushConstants.scene_constants.view_matrix * vec4(world_position, 1);

    if ( view_position.z < 0.1f )
    {
        payload.position = world_position;
        const float dist = distance(PushConstants.scene_constants.camera_position, world_position);
        int lod = 3;
        while ( dist < lod * PushConstants.lod_cutoff )
        {
            --lod;
        }
        payload.lod = lod;
        EmitMeshTasksEXT(meshes[PushConstants.mesh].lods[lod].meshlets_count, 1, 1);
    }
}
