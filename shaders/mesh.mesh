#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_GOOGLE_include_directive : require

#include "constants.glsl"
#include "math.glsl"
#include "mesh.glsl"

// Triangle culling (back faces, zero area, triangles between samples) with gl_CullPrimitiveEXT. Off: it culled 3.4% of
// the early pass triangles and 11% of the shadows' (2026-11-04), but the work it adds to every workgroup (shared
// positions, barrier, per triangle tests) cost more than it saved: early pass 3.39-3.57 -> 3.02-3.16 ms at 4x MSAA,
// 2.68 -> 2.32 ms at 1x, shadows unchanged. Compacting the surviving triangles would only add to that work
#define TRIANGLE_CULLING 0

layout( local_size_x = 32, local_size_y = 1, local_size_z = 1 ) in;
layout( triangles, max_vertices = 64, max_primitives = 96 ) out;

layout( std430, set = 1, binding = 0 ) readonly buffer ssbo1
{
	Mesh meshes[];
};
layout( std430, set = 1, binding = 1 ) readonly buffer ssbo2
{
	Material materials[];
};

// Interpolants are packed into as few locations as possible: each one costs mesh shader output memory, and the far LOD
// bins are bound by the primitive engine. The tangent's bitangent sign goes with the material. Rebuilding the world
// position from the depth in the fragment shader saves another location, but costs more than it saves in the shading
// bound near LOD bins
layout( location = 0 ) out vec3 outNormal[];
layout( location = 0, component = 3 ) out float outU[];
layout( location = 1 ) out vec3 outTangent[];
layout( location = 1, component = 3 ) out float outV[];
layout( location = 2 ) out vec3 outWorldPos[];
layout( location = 3 ) out flat uint outMaterial[];

layout( buffer_reference, std430 ) readonly buffer DrawCommandsBuffer
{
	MeshTaskCommand commands[];
};

layout( push_constant, std430 ) uniform block
{
	FrameConstants frame_constants;
	PassConstants pass_constants;
	MeshDrawBuffer draws_buffer;
	DrawCommandsBuffer commands_buffer;
};

taskPayloadSharedEXT MeshletTaskPayload payload;

#if TRIANGLE_CULLING
// Vertex positions in pixels (y up, like NDC) and clip w, for triangle culling
shared vec3 vertex_pixels[ 64 ];
#endif

void main()
{
	const uint draw_id = payload.draw_id;
	const uint mesh_id = draws_buffer.mesh_draws[ draw_id ].mesh;

	const uint meshlet_id = payload.meshlets[ gl_WorkGroupID.x ];
	Meshlet meshlet = meshes[ mesh_id ].mb.meshlets[ meshlet_id ];
	SetMeshOutputsEXT( meshlet.vertex_count, meshlet.triangle_count );

	for ( uint i = gl_LocalInvocationIndex; i < meshlet.vertex_count; i += gl_WorkGroupSize.x )
	{
		const uint index = meshes[ mesh_id ].mvb.meshlet_vertices[ meshlet.vertex_offset + i ];
		const Vertex v = meshes[ mesh_id ].vb.vertices[ index ];
		const vec3 pos = rotate_by_quaternion( v.position, draws_buffer.mesh_draws[ draw_id ].rotation )
				* draws_buffer.mesh_draws[ draw_id ].scale
			+ draws_buffer.mesh_draws[ draw_id ].translation;
		const vec4 clip_pos = pass_constants.data.view_projection_matrix * vec4( pos, 1 );
		gl_MeshVerticesEXT[ i ].gl_Position = clip_pos;
#if TRIANGLE_CULLING
		// Only meaningful for w > 0, triangles with vertices behind the camera are never culled
		vertex_pixels[ i ] = vec3( ( clip_pos.xy / clip_pos.w * 0.5 + 0.5 ) * pass_constants.data.viewport_size, clip_pos.w );
#endif
		outNormal[ i ] = rotate_by_quaternion( v.normal, draws_buffer.mesh_draws[ draw_id ].rotation );
		outU[ i ] = v.uv_x;
		outTangent[ i ] = rotate_by_quaternion( v.tangent.xyz, draws_buffer.mesh_draws[ draw_id ].rotation );
		outV[ i ] = v.uv_y;
		outWorldPos[ i ] = pos;
		outMaterial[ i ] = pack_material( draws_buffer.mesh_draws[ draw_id ].material, v.tangent.w );
	}

#if TRIANGLE_CULLING
	barrier();

	// Triangle culling, saves primitive setup/rasterization cost for triangles that wouldn't produce any sample:
	// - Back faces of single sided materials, matching the pipeline cull mode (counter-clockwise front faces)
	// - Zero area triangles
	// - Small triangles whose bounding box doesn't contain any sample position on one axis. Standard sample locations for
	//   1, 2, 4 and 8 samples project to (k + 0.5) / sample_count on each axis
	const bool single_sided = is_single_sided( materials[ draws_buffer.mesh_draws[ draw_id ].material ].type );
	const float sample_grid = float( pass_constants.data.sample_count );
#endif

	for ( uint i = gl_LocalInvocationIndex; i < meshlet.triangle_count; i += gl_WorkGroupSize.x )
	{
		const uint offset = meshlet.triangle_offset + i * 3;
		const uvec3 triangle = uvec3( meshes[ mesh_id ].mtb.meshlet_triangles[ offset ],
									  meshes[ mesh_id ].mtb.meshlet_triangles[ offset + 1 ],
									  meshes[ mesh_id ].mtb.meshlet_triangles[ offset + 2 ] );
		gl_PrimitiveTriangleIndicesEXT[ i ] = triangle;

#if TRIANGLE_CULLING
		const vec3 a = vertex_pixels[ triangle.x ];
		const vec3 b = vertex_pixels[ triangle.y ];
		const vec3 c = vertex_pixels[ triangle.z ];

		// Signed area (times 2): positive for counter-clockwise triangles in y up pixel space
		const vec2 ab = b.xy - a.xy;
		const vec2 ac = c.xy - a.xy;
		const float area = ab.x * ac.y - ab.y * ac.x;
		bool culled = single_sided ? area <= 0.0 : area == 0.0;

		// Scaled by the sample count, sample positions are at n + 0.5: both bounds rounding to the same integer means no
		// sample in between on that axis
		const vec2 bbox_min = min( a.xy, min( b.xy, c.xy ) ) * sample_grid;
		const vec2 bbox_max = max( a.xy, max( b.xy, c.xy ) ) * sample_grid;
		culled = culled || any( equal( round( bbox_min ), round( bbox_max ) ) );

		// Pixel positions are meaningless if any vertex is behind the camera, don't cull these
		culled = culled && a.z > 0.0 && b.z > 0.0 && c.z > 0.0;
		gl_MeshPrimitivesEXT[ i ].gl_CullPrimitiveEXT = culled;
#endif
	}
}
